HOST=0.0.0.0
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wwjing_db
DB_USER=wwjing_user
DB_PASSWORD=replace-with-database-password
JWT_SECRET_KEY=replace-with-jwt-secret
NODE_ENV=development
LOG_LEVEL=debug
SERVICE_NAME=wwjing_server

# Agnes AI; keep these values on the server and never expose them to the Web app.
AI_API_KEY=replace-with-agnes-api-key
AI_BASE_URL=https://apihub.agnes-ai.com/v1
AI_MODEL=agnes-2.5-flash
AI_TIMEOUT_MS=30000
