<script setup>
import { computed, ref, watch } from "vue";
import { useRoute, useRouter } from "vue-router";
import { ArrowLeft, ArrowRight, CollectionTag, Close, Folder, FolderOpened, House, KnifeFork, Star, SwitchButton, Tools, User } from "@element-plus/icons-vue";

const router = useRouter();
const route = useRoute();
const isMobile = () => window.matchMedia("(max-width: 640px)").matches;
const menuVisible = ref(!isMobile());
const toolsExpanded = ref(route.path.startsWith("/tools"));
const bookmarksExpanded = ref(route.path.startsWith("/tools/bookmarks"));
const user = JSON.parse(localStorage.getItem("wwjing_user") || "null");

const navigationItems = [
  { path: "/", label: "首页", icon: House },
  { path: "/tools", label: "工具", icon: Folder, children: [
    { path: "/tools", label: "工具首页", icon: FolderOpened },
    { path: "/tools/transfer", label: "数据传输", icon: Tools },
    { path: "/tools/bookmarks", label: "收藏夹", icon: CollectionTag, children: [
      { path: "/tools/bookmarks/kitchen", label: "疯狂的厨房", icon: KnifeFork },
      { path: "/tools/bookmarks/star", label: "鲸界", icon: Star }
    ] }
  ] }
];

const isHomeActive = computed(() => route.path === "/");
const isToolsActive = computed(() => route.path.startsWith("/tools"));

watch(() => route.path, (path) => {
  if (path.startsWith("/tools")) toolsExpanded.value = true;
  if (path.startsWith("/tools/bookmarks")) bookmarksExpanded.value = true;
});

function go(path) { router.push(path); if (isMobile()) menuVisible.value = false; }
function toggleMenu() { menuVisible.value = !menuVisible.value; }
function toggleTools() { toolsExpanded.value = !toolsExpanded.value; }
function toggleBookmarks() { bookmarksExpanded.value = !bookmarksExpanded.value; }
function logout() { localStorage.removeItem("wwjing_token"); localStorage.removeItem("wwjing_user"); router.replace("/login"); }
</script>
