}

function updateCell(rowIndex, cellIndex, value, sync = true) {
  const key = `${activeTopicId.value}:${rowIndex + 2}:${cellIndex}`;
  if (editingCell.value !== key) beginCellEdit(rowIndex + 2, cellIndex);
  if (!editingLockSent.value) {
    if (cellLocks.value[key] && cellLocks.value[key] !== currentDisplayName.value) return;
    editingLockSent.value = true;
    cellLocks.value[key] = currentDisplayName.value;
    send({ type: "cell:lock", topicId: activeTopicId.value, row: rowIndex + 2, column: cellIndex });
  }
  drafts[key] = value;
  send({ type: "cell:draft", topicId: activeTopicId.value, row: rowIndex + 2, column: cellIndex, value });
}

async function flushEditingCell() {
  if (!editingCell.value || !activeTopic.value) return;
  const editingKey = editingCell.value;
  const topicId = activeTopicId.value;
  const roomId = activeRoomId.value;
  const password = roomPassword.value;
  const connectionSequence = roomConnectionSequence;
  const [, rowText, columnText] = editingKey.split(":");
  const row = Number(rowText);
  const column = Number(columnText);
  const topic = activeTopic.value;
  const value = drafts[editingKey] ?? (topic.cells[row]?.[column] || "");
  if (!editingLockSent.value && value === editingOriginalValue.value && !failedCellSaves.has(editingKey)) {
    delete drafts[editingKey];
    editingCell.value = null;
    return;
  }
  // 立即结束本次编辑；保存回调不能操作后来获得焦点的单元格。
  editingCell.value = null;
  editingLockSent.value = false;
  delete drafts[editingKey];
  pendingLocalValues[editingKey] = value;
  topic.cells[row] ||= [];
  topic.cells[row][column] = value;
  topic.cellAuthors ||= {};
  topic.cellEditedAt ||= {};
  const authorKey = `${row}:${column}`;
  if (String(value).trim()) {
    topic.cellAuthors[authorKey] = currentDisplayName.value;
    (topic.cellAuthorIds ||= {})[authorKey] = officeClientId;
    topic.cellEditedAt[authorKey] = Date.now();
    rememberEdit(topicId, authorKey, topic.cellEditedAt[authorKey]);
  } else {
    delete topic.cellAuthors[authorKey];
    if (topic.cellAuthorIds) delete topic.cellAuthorIds[authorKey];
    delete topic.cellEditedAt[authorKey];
    notifiedEdits.delete(`${topicId}:${authorKey}`);
  }
  saveState.value = "保存中";
  const saveKey = `${connectionSequence}:${editingKey}`;
  const version = (cellSaveVersions.get(saveKey) || 0) + 1;
  cellSaveVersions.set(saveKey, version);
  const previous = pendingCellSaves.get(saveKey) || Promise.resolve();
  const finish = () => {
    if (pendingCellSaves.get(saveKey) === save) {
      pendingCellSaves.delete(saveKey);
      cellSaveVersions.delete(saveKey);
      if (connectionSequence === roomConnectionSequence && saveState.value === "保存中") {
        saveState.value = failedCellSaves.size ? "保存失败" : pendingCellSaves.size ? "保存中" : "已同步";
      }
    }
  };
  const save = previous.catch(() => {}).then(async () => {
    const sameRoom = connectionSequence === roomConnectionSequence && roomId === activeRoomId.value;
    const requestId = `${Date.now()}-${Math.random().toString(36).slice(2)}`;
    if (sameRoom) {
      pendingUpdates[requestId] = { key: editingKey, topicId, row, column, value };
      send({ type: "cell:update", requestId, topicId, row, column, value });
    }
    const saved = await updateCellFallback(topicId, row, column, value, roomId, password);
    const currentRoom = connectionSequence === roomConnectionSequence && roomId === activeRoomId.value;
    const latest = cellSaveVersions.get(saveKey) === version;
    if (!currentRoom || !latest) return;
    if (!saved) {
      failedCellSaves.add(editingKey);
      saveState.value = "保存失败";
      ElMessage.error("单元格保存失败，请检查房间连接后重试");
      return;
    }
    failedCellSaves.delete(editingKey);
    if (editingCell.value !== editingKey || !editingLockSent.value) {
      delete cellLocks.value[editingKey];
      send({ type: "cell:unlock", topicId, row, column });
      updateLockFallback(row, column, false, topicId, roomId, password);
    }
    fitColumnWidth(column);
  });
  pendingCellSaves.set(saveKey, save);
  try { await save; } finally { finish(); }
}

function displayCellValue(row, column) {
  const key = cellKey(row, column);
  return Object.prototype.hasOwnProperty.call(drafts, key) ? drafts[key] : activeTopic.value?.cells?.[row]?.[column] || "";
}

function handleFocusOut(event) {
  if (event.target?.tagName === "INPUT") {
    const key = event.target.dataset.officeUnreadKey;
    if (key && key === editingCell.value) flushEditingCell();
    if (event.target.closest(".sheet-title-cell, .sheet-header")) flushFixedCellWrites();
    if (key) {
      delete unreadCells.value[key];
      delete event.target.dataset.officeUnreadKey;
      syncCellLockBadges();
    }
  }
}

function clearUnreadCell(row, column) {
  delete unreadCells.value[cellKey(row, column)];
}

function getOfficeCellPosition(target) {
  const cell = target?.closest?.(".workbench-sheet tbody td:not(.row-number)");
  const row = cell?.closest("tr");
  if (!row || !activeTopic.value) return null;
  const rowIndex = [...row.parentElement.children].indexOf(row);
  const column = cell.cellIndex - 1;
  if (rowIndex < 0 || column < 0) return null;
  return { cell, row: rowIndex + 2, column, key: cellKey(rowIndex + 2, column) };
}

function markOfficeCellRead(position) {
  clearUnreadCell(position.row, position.column);
  delete position.cell.dataset.unread;
}

function handleCellClick(event) {
  const position = getOfficeCellPosition(event.target);
  if (position) markOfficeCellRead(position);
}

function handleOfficePointerDown(event) {
  requestOfficeNotifications();
  if (event.button !== undefined && event.button !== 0) return;
  const position = getOfficeCellPosition(event.target);
  if (position) {
    markOfficeCellRead(position);
    if (editingCell.value && editingCell.value !== position.key) {
      const previousInput = document.activeElement;
      if (previousInput?.dataset?.officeUnreadKey === editingCell.value) previousInput.blur?.();
      if (editingCell.value && editingCell.value !== position.key) flushEditingCell();
    }
    if (!event.target.closest?.(".row-resize-handle") && event.target.tagName !== "INPUT") {
      position.cell.querySelector("input")?.focus();
    }
  } else if (editingCell.value && event.target !== document.activeElement) {
    flushEditingCell();
  }
}

function handleOfficeWindowBlur() {
  flushEditingCell();
  flushFixedCellWrites();
  if (document.activeElement?.dataset?.officeUnreadKey) document.activeElement.blur();
}

function handleFocusIn(event) {
  const input = event.target;
  if (input.tagName !== "INPUT" || !activeTopic.value) return;
  const row = input.closest("tbody tr");
  const cell = input.closest("td");
  if (!row || !cell) return;
  const rowIndex = [...row.parentElement.children].indexOf(row);
  const column = cell.cellIndex - 1;
  const key = cellKey(rowIndex + 2, column);
  if (editingCell.value && editingCell.value !== key) {
    delete unreadCells.value[editingCell.value];
    flushEditingCell();
  }
  delete unreadCells.value[key];
  syncCellLockBadges();
  input.dataset.officeUnreadKey = key;
  if (cellLocks.value[key] && cellLocks.value[key] !== currentDisplayName.value) {
    input.blur();
    ElMessage.warning(`${cellLocks.value[key]}正在编辑此单元格`);
    return;
  }
  selectedCell.value = `${String.fromCharCode(65 + column)}${rowIndex + 3}`;
  if (editingCell.value !== key) beginCellEdit(rowIndex + 2, column);
}

const fixedCellWriteTimers = new Map();
function flushFixedCellWrites() {
  let changed = false;
  for (const [key, pending] of fixedCellWriteTimers) {
    window.clearTimeout(pending.timer);
    fixedCellWriteTimers.delete(key);
    if (pending.roomId !== activeRoomId.value) continue;
    changed = true;
    send({ type: "cell:update", topicId: pending.topicId, row: pending.row, column: pending.column, value: pending.value });
    updateCellFallback(pending.topicId, pending.row, pending.column, pending.value);
  }
  if (changed) scheduleFitAllColumnWidths(true);
}

function scheduleFixedCellWrite(row, column, value) {
  const key = `${activeTopicId.value}:${row}:${column}`;
  window.clearTimeout(fixedCellWriteTimers.get(key)?.timer);
  const pending = { roomId: activeRoomId.value, topicId: activeTopicId.value, row, column, value };
  pendingLocalValues[key] = value;
  pending.timer = window.setTimeout(flushFixedCellWrites, 300);
  fixedCellWriteTimers.set(key, pending);
}

function updateTitle(value) {
  if (activeTopic.value) {
    activeTopic.value.cells[0][0] = value;
    activeTopic.value.cellAuthors ||= {};
