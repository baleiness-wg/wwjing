{
  "name": "wwjing",
  "private": true,
  "description": "WWJ Vue frontend with Node and Go APIs",
  "scripts": {
    "install": "npm install --prefix server-node && npm install --prefix web",
    "dev": "npm run dev:all",
    "dev:server": "npm run dev --prefix server-node",
    "dev:web": "npm run dev --prefix web",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "start": "npm start --prefix server-node",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:logs": "pm2 logs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "rxjs": "^7.8.2"
  }
}
