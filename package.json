{
  "name": "wwjing",
  "private": true,
  "description": "WWJ Vue frontend and Express API",
  "scripts": {
    "install": "npm install --prefix server && npm install --prefix web",
    "dev": "npm run dev:all",
    "dev:server": "npm run dev --prefix server",
    "dev:web": "npm run dev --prefix web",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "start": "npm start --prefix server",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart wwjing-server",
    "pm2:stop": "pm2 stop wwjing-server",
    "pm2:logs": "pm2 logs wwjing-server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
